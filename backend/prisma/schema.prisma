generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  SUPER_ADMIN
  STAFF
}

enum LeadSource {
  WALK_IN
  MANUAL_OTHER
  META_ADS
  WHATSAPP
  INSTAGRAM
  GOOGLE_SHEETS
  REFERRAL
  VOICE_AGENT
}

enum EnquiryType {
  NEW_CAR
  USED_CAR
  SERVICE_RELATED
  ACCESSORY
  OTHER
}

enum EnquiryStatus {
  NEW
  // A sub-state, not a stepper milestone — an enquiry being actively followed up still
  // sits at the "New" node in the pipeline UI; this just labels the status badge.
  UNDER_FOLLOW_UP
  APPOINTMENT_FIXED
  TEST_DRIVE
  BOOKED
  RETAIL_DONE
  RTO_DONE
  DELIVERED
  CLOSED
}

enum LossReason {
  LOST_TO_DEALER
  BOOKING_CANCEL
  RETAIL_CANCEL
  OUT_OF_TERRITORY
  NOT_CONTACTABLE
  PRICE_ISSUE
  PURCHASED_ANOTHER_BRAND
  OTHER_REASON
}

enum FollowUpType {
  CALL
  WHATSAPP
  VISIT
  EMAIL
}

enum FinanceStatus {
  NOT_STARTED
  DOCS_PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

// Business department the enquiry belongs to — distinct from EnquiryType (which is
// "what kind of car interest": new/used/service/accessory). Captured on the offline
// intake form alongside EnquiryType, not a replacement for it.
enum Department {
  SALES
  SERVICE
  USED_CAR
  ACCESSORIES
  HR
  OTHER_TERRITORY
  OTHERS
}

enum LeadSubsource {
  WALK_IN
  HMIL_WEBSITE
  HMIL_SOCIAL_MEDIA
  HMIL_CHATBOT
  SOCIAL_MEDIA
  HYPERLOCAL
  CARPORTAL
  CTB
  CRM
  REFERRAL
  CUSTOMER_REFERRAL
  EMPLOYEE_REFERRAL
  INCOMING_CALL
  DEALER_ACTIVITY
  SC_OWN_SOURCE
  HMIL_EVENT
  EXCHANGE_CAMP
}

enum SourceCategory {
  WALK_IN
  DIGITAL
  DIGITAL_WALK_IN
  REFERRAL
  FIELD_ACTIVITY
  TELE_IN
}

enum EnquiryCategory {
  HOT
  WARM
  COLD
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  CNG_PETROL
  ELECTRIC
}

enum IntegrationKey {
  META_ADS
  WHATSAPP
  INSTAGRAM
  GOOGLE_SHEETS
  LIVEKIT
  TELECMI
  GEMINI
  OPENAI
  CLOUDINARY
  CALLMATIC
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

enum SocialChannel {
  WHATSAPP
  INSTAGRAM
  VOICE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AgentType {
  VOICE
  WHATSAPP_CHATBOT
  INSTAGRAM_CHATBOT
}

enum CallStatus {
  QUEUED
  DIALING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  FAILED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// Outcome of the automated Voice AI outbound call itself (did the phone get answered),
// distinct from CallStatus which tracks the CallLog/OutboundCallTask lifecycle.
enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
}

// The lead's stated intent once the Voice AI actually gets them on the line.
enum EnquiryResponse {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  FOLLOW_UP
}

// What the CR team should do next, derived from callOutcome/response after the auto-call.
enum NextAction {
  RETRY_CALL
  SCHEDULE_CALLBACK
  SCHEDULE_FOLLOW_UP
  ASSIGN_TO_CR
  MARK_LOST
}

// ---------- VEHICLE CATALOG ----------
// A pure pick-list for the Add Lead form's Model/Variant dropdowns. Deliberately NOT
// foreign-keyed from Enquiry — Enquiry.carModel/variant stay plain-string snapshots (like
// every other Enquiry field), so editing/deactivating/deleting a catalog entry later can
// never mutate or orphan a historical enquiry.

model VehicleModel {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants VehicleVariant[]

  @@map("vehicle_models")
}

model VehicleVariant {
  id               String           @id @default(cuid())
  modelId          String
  model            VehicleModel     @relation(fields: [modelId], references: [id])
  name             String
  transmissionType TransmissionType
  fuelType         FuelType
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([modelId, name, fuelType])
  @@map("vehicle_variants")
}

// ---------- CORE ----------

model Branch {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  city              String
  address           String?
  autoAssignEnabled Boolean  @default(true)
  // Per-branch override for the Voice AI auto-dial pipeline — both this AND
  // AgentConfig(VOICE).autoCallEnabled must be true for a digital lead in this branch
  // to get auto-called.
  autoCallEnabled   Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users               User[]
  enquiries           Enquiry[]
  roleDefinitions     RoleDefinition[]
  leadDrafts          LeadDraft[]
  consultantDirectory ConsultantDirectory[]

  @@map("branches")
}

// A branch-scoped custom role ("Assistant Manager - OMR") with explicit per-section
// None/Read/Write permissions, enforced by backend middleware (requirePermission).
model RoleDefinition {
  id                 String   @id @default(cuid())
  name               String
  branchId           String? // null = available to every branch
  branch             Branch?  @relation(fields: [branchId], references: [id])
  permissions        Json // { [section: ModuleKey]: "none" | "read" | "write" }
  canViewAllBranches Boolean  @default(false)
  restrictLeadsToOwn Boolean  @default(false)
  // Only meaningful when restrictLeadsToOwn is true: lets the CR view (not edit/change-status
  // on) leads assigned to other CRs in their own branch, instead of only their own.
  canViewBranchLeads Boolean  @default(false)
  isActive           Boolean  @default(true)
  // True only for the built-in seeded "CR" role — its name can't be renamed and the
  // role can't be deleted, but its permissions/toggles stay fully editable like any
  // other role.
  isSystemDefault    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]

  @@unique([branchId, name])
  @@map("role_definitions")
}

// Lightweight directory of consultants (no login/password) — Name, Mobile, Branch only.
model ConsultantDirectory {
  id        String   @id @default(cuid())
  name      String
  mobile    String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries          Enquiry[]
  testDriveFeedbacks TestDriveFeedback[]

  @@index([branchId])
  @@map("consultant_directory")
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  phone                 String?
  passwordHash          String
  role                  Role
  roleDefinitionId      String?
  roleDefinition        RoleDefinition? @relation(fields: [roleDefinitionId], references: [id])
  branchId              String?
  branch                Branch?         @relation(fields: [branchId], references: [id])
  // Independent of role: additionally lets this user act as a CR (appear in the
  // CR-assignment dropdown, and be exempt from lead-ownership restriction for leads
  // assigned to them), additive on top of their normal role's permissions.
  isCr                  Boolean         @default(false)
  isActive              Boolean         @default(true)
  isAvailableForRouting Boolean         @default(true)
  avatarUrl             String?
  avatarPublicId        String?
  lastActiveAt          DateTime?
  onBreak               Boolean         @default(false)
  breakStartedAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignedEnquiries       Enquiry[]              @relation("AssignedCr")
  statusChanges           EnquiryStatusHistory[] @relation("ChangedBy")
  dateChanges             DateChangeHistory[]    @relation("DateChangedBy")
  enquiryNotes            EnquiryNote[]          @relation("NoteAuthor")
  followUps               FollowUp[]
  reassignmentsFrom       ReassignmentLog[]      @relation("ReassignFrom")
  reassignmentsTo         ReassignmentLog[]      @relation("ReassignTo")
  reassignmentsBy         ReassignmentLog[]      @relation("ReassignBy")
  quotationsCreated       Quotation[]            @relation("QuotedBy")
  evaluationsDone         ExchangeEvaluation[]   @relation("EvaluatedBy")
  integrationUpdates      IntegrationConfig[]    @relation("IntegrationUpdatedBy")
  convertedInboxItems     Conversation[]         @relation("ConvertedBy")
  agentConfigUpdates      AgentConfig[]          @relation("AgentConfigUpdatedBy")
  uploadedMedia           MediaAsset[]           @relation("MediaUploadedBy")
  createdTemplates        MessageTemplate[]      @relation("TemplateCreatedBy")
  createdCallCampaigns    OutboundCallCampaign[] @relation("CallCampaignCreatedBy")
  createdMessageCampaigns MessageCampaign[]      @relation("MessageCampaignCreatedBy")
  leadDrafts              LeadDraft[]
  comments                Comment[]
  notifications           Notification[]
  reminderDismissals      ReminderDismissal[]

  @@index([branchId, role])
  @@map("users")
}

// ---------- LEAD / DEDUP ----------

model Lead {
  id              String    @id @default(cuid())
  name            String
  phoneRaw        String
  phoneNormalized String    @unique
  email           String?
  // Extended profile fields — captured on offline (walk-in) intake, or filled in later by
  // a CR completing a digital lead's profile. All optional: a fresh digital lead has none of these.
  alternateMobile String?
  dob             DateTime?
  profession      String?
  pincode         String?
  // Locality/area within the city. Nullable at the DB level so pre-existing leads stay
  // valid; the Add Lead intake form requires it.
  area            String?
  address         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enquiries     Enquiry[]
  conversations Conversation[]
  touches       LeadTouch[]

  @@index([phoneNormalized])
  @@map("leads")
}

// One row per inbound contact from this person — a walk-in visit, a Meta form submission,
// a WhatsApp/Instagram first contact, a sheet import row. This is what lets the CR team see
// "enquired 3 times: 2 walk-in, 1 Meta" even when those contacts all attach to one Enquiry.
model LeadTouch {
  id        String     @id @default(cuid())
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id])
  enquiryId String?
  source    LeadSource
  note      String?
  createdAt DateTime   @default(now())

  @@index([leadId, createdAt])
  @@map("lead_touches")
}

model Enquiry {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  carModel    String
  source      LeadSource
  enquiryType EnquiryType
  location    String?

  // Offline-intake enrichment — optional, filled by the CR either at walk-in intake or
  // later via the "Complete Customer Details" flow for a digital lead. See Department vs
  // EnquiryType note on the Department enum above.
  department           Department?
  subsource            LeadSubsource?
  sourceCategory       SourceCategory?
  // Name of the existing customer/employee who referred this lead — only meaningful when
  // sourceCategory is REFERRAL, but left unconstrained since it's plain intake text.
  referrerName         String?
  referrerPhone        String?
  variant              String?
  enquiryCategory      EnquiryCategory?
  financeRequired      Boolean?
  financeRemarks       String?
  appointmentScheduled Boolean          @default(false)
  appointmentAt        DateTime?
  // Customer's stated test-drive interest/history at intake — distinct from
  // TestDriveFeedback, which records the actual conducted test drive later in the pipeline.
  testDriveInterested  Boolean          @default(false)
  testDriveCount       Int?
  // Customer-stated exchange car snapshot at intake — distinct from ExchangeEvaluation,
  // which records the formal trade-in valuation later in the pipeline.
  exchangeCarModel     String?
  exchangeCarYear      Int?
  exchangeCarKms       Int?
  exchangeCarOwners    Int?
  exchangeCarRegNumber String?
  calledDate           DateTime?
  remarks              String?

  status        EnquiryStatus @default(NEW)
  followUpDueAt DateTime?
  lossReason    LossReason?
  lossNote      String?

  // ── Pipeline milestone metadata (set as the enquiry advances through the stepper) ──
  // Booking-phase finance: `financeRequired` (above) is the toggle; when on, these three
  // Yes/No checks track the loan progress. Null = not answered yet.
  financeDocumentCollected Boolean?
  financeLoanApproved      Boolean?
  financeDoReceived        Boolean?
  // Dates captured when the enquiry reaches each milestone, so the stepper and reports can
  // show exactly when each stage happened (distinct from createdAt of a status-history row).
  bookedAt     DateTime?
  retailDoneAt DateTime?
  rtoDoneAt    DateTime?
  deliveredAt  DateTime?
  // Vehicle colour, captured at the RTO Done stage alongside the RTO date.
  colour       String?

  // Digital-lead auto-dial pipeline (Voice AI outbound call on new digital enquiries).
  score         Int              @default(0)
  callTriggered Boolean          @default(false)
  callOutcome   CallOutcome?
  response      EnquiryResponse?
  nextAction    NextAction?

  assignedCrId String?
  assignedCr   User?                @relation("AssignedCr", fields: [assignedCrId], references: [id])
  consultantId String?
  consultant   ConsultantDirectory? @relation(fields: [consultantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory      EnquiryStatusHistory[]
  dateChangeHistory  DateChangeHistory[]
  notes              EnquiryNote[]
  comments           Comment[]
  followUps          FollowUp[]
  reassignmentLogs   ReassignmentLog[]
  testDriveFeedbacks TestDriveFeedback[]
  quotation          Quotation?
  exchangeEvaluation ExchangeEvaluation?
  financeApplication FinanceApplication?
  deliveryDetails    DeliveryDetails?
  outboundCallTasks  OutboundCallTask[]

  @@index([branchId, status])
  @@index([assignedCrId])
  @@index([createdAt])
  // listEnquiries/buildWhere in leads.service.ts filters by branchId + status + createdAt
  // together; this composite index lets Postgres satisfy that combination with a single
  // index scan instead of falling back to the narrower branchId+status or createdAt indexes.
  @@index([branchId, status, createdAt])
  // The leads/customers lists group + paginate by leadId (and order by createdAt);
  // without this, Postgres sequential-scans the whole enquiry table on every page.
  @@index([leadId, createdAt])
  // Reports Chart Builder / source-performance group enquiries by these dimensions.
  @@index([source])
  @@index([enquiryCategory])
  // The Referral Leads report filters on this dimension specifically.
  @@index([sourceCategory])
  @@map("enquiries")
}

/// A CR's private scratch note on an enquiry — visible only to whoever wrote it (the API
/// always scopes reads to the caller), unlike Comment, which the whole team sees.
model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([enquiryId, authorId, createdAt])
  @@map("enquiry_notes")
}

/// Corrections to a pipeline milestone date (appointment, booking, retail). Every edit
/// carries a mandatory reason and is kept forever, so a date that moved can always be
/// explained — the enquiry row itself only ever holds the current value.
enum DateFieldKey {
  APPOINTMENT_AT
  TEST_DRIVE_SCHEDULED_AT
  BOOKED_AT
  RETAIL_DONE_AT
}

model DateChangeHistory {
  id          String       @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry      @relation(fields: [enquiryId], references: [id])
  field       DateFieldKey
  oldValue    DateTime?
  newValue    DateTime
  reason      String       @db.Text
  changedById String
  changedBy   User         @relation("DateChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([enquiryId, createdAt])
  @@map("date_change_history")
}

model EnquiryStatusHistory {
  id          String         @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry        @relation(fields: [enquiryId], references: [id])
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  changedById String
  changedBy   User           @relation("ChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime       @default(now())

  @@index([enquiryId, createdAt])
  @@map("enquiry_status_history")
}

model FollowUp {
  id               String       @id @default(cuid())
  enquiryId        String
  enquiry          Enquiry      @relation(fields: [enquiryId], references: [id])
  followUpDate     DateTime     @db.Date
  followUpTime     String?
  type             FollowUpType
  remark           String       @db.Text
  nextFollowUpDate DateTime?    @db.Date
  nextFollowUpTime String?
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())

  @@index([enquiryId, followUpDate])
  @@map("follow_ups")
}

model ReassignmentLog {
  id             String   @id @default(cuid())
  enquiryId      String
  enquiry        Enquiry  @relation(fields: [enquiryId], references: [id])
  fromUserId     String?
  fromUser       User?    @relation("ReassignFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User     @relation("ReassignTo", fields: [toUserId], references: [id])
  reassignedById String
  reassignedBy   User     @relation("ReassignBy", fields: [reassignedById], references: [id])
  reason         String?
  createdAt      DateTime @default(now())

  @@map("reassignment_logs")
}

// A CR's in-progress offline intake, saved before all required fields are filled.
// Deliberately separate from Enquiry (rather than an EnquiryStatus value) so a draft never
// participates in routing/reporting/pipeline logic that assumes a real enquiry exists —
// `data` is a free-form snapshot of whatever the wizard had at save time.
model LeadDraft {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("lead_drafts")
}

// ---------- PIPELINE SUB-TABLES ----------

// 1:many with Enquiry — a client can take several test drives (different variants,
// family members, a second look) before deciding.
model TestDriveFeedback {
  id            String    @id @default(cuid())
  enquiryId     String
  enquiry       Enquiry   @relation(fields: [enquiryId], references: [id])
  // Points at the ConsultantDirectory entry who conducted the drive — consultants no
  // longer have login User accounts, so this can no longer be a User FK.
  conductedById String
  conductedBy   ConsultantDirectory @relation(fields: [conductedById], references: [id])
  // Which car this drive was for. A customer may test several — same car again, or a
  // different model/variant — so each row snapshots its own car (defaults to the enquiry's).
  carModel      String?
  variant       String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  // Where the drive takes place (customer's address / pickup point). Free-text, optional, and
  // editable at any time — before or after the drive is completed.
  address       String?
  // The consultant's feedback form, stored structurally in the DB (not an uploaded file):
  // an overall rating plus written comments.
  rating        Int?
  comments      String?
  createdAt     DateTime  @default(now())

  @@index([enquiryId, createdAt])
  @@map("test_drive_feedback")
}

model Quotation {
  id          String    @id @default(cuid())
  enquiryId   String    @unique
  enquiry     Enquiry   @relation(fields: [enquiryId], references: [id])
  quotedById  String
  quotedBy    User      @relation("QuotedBy", fields: [quotedById], references: [id])
  variant     String?
  onRoadPrice Decimal   @db.Decimal(12, 2)
  discount    Decimal?  @db.Decimal(12, 2)
  finalPrice  Decimal   @db.Decimal(12, 2)
  validUntil  DateTime?
  pdfUrl      String?
  createdAt   DateTime  @default(now())

  @@map("quotations")
}

model ExchangeEvaluation {
  id              String   @id @default(cuid())
  enquiryId       String   @unique
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id])
  oldCarMake      String
  oldCarModel     String
  oldCarYear      Int
  oldCarKms       Int
  oldCarCondition String?
  valuationAmount Decimal  @db.Decimal(12, 2)
  evaluatedById   String
  evaluatedBy     User     @relation("EvaluatedBy", fields: [evaluatedById], references: [id])
  evaluatedAt     DateTime @default(now())

  @@map("exchange_evaluations")
}

model FinanceApplication {
  id              String        @id @default(cuid())
  enquiryId       String        @unique
  enquiry         Enquiry       @relation(fields: [enquiryId], references: [id])
  bankOrNbfc      String
  loanAmount      Decimal?      @db.Decimal(12, 2)
  status          FinanceStatus @default(NOT_STARTED)
  docsChecklist   Json?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("finance_applications")
}

model DeliveryDetails {
  id                String    @id @default(cuid())
  enquiryId         String    @unique
  enquiry           Enquiry   @relation(fields: [enquiryId], references: [id])
  rcTransferDone    Boolean   @default(false)
  insuranceDone     Boolean   @default(false)
  accessoriesFitted Boolean   @default(false)
  deliveryDate      DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("delivery_details")
}

// ---------- INTEGRATIONS (Phase 2) ----------

model IntegrationConfig {
  id                   String            @id @default(cuid())
  key                  IntegrationKey    @unique
  // AES-256-GCM encrypted JSON blob of credentials — see backend/src/lib/crypto.ts.
  // Never decrypted for API responses; only decrypted server-side when calling the provider.
  encryptedCredentials String?
  status               IntegrationStatus @default(NOT_CONFIGURED)
  // When false, getCredentials() in integrations.service.ts refuses to hand out credentials —
  // this is the single chokepoint that turns an integration off everywhere it's used.
  enabled              Boolean           @default(true)
  lastError            String?
  lastTestedAt         DateTime?
  updatedAt            DateTime          @updatedAt
  updatedById          String?
  updatedBy            User?             @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id])

  @@map("integration_configs")
}

// One row per Facebook Page connected via the Meta Ads "Login with Facebook" OAuth flow.
// The IntegrationConfig(key=META_ADS) row holds the FB user identity + long-lived user token;
// each Page gets its own row here since Page access tokens differ per Page.
model MetaAdsPage {
  id                   String    @id @default(cuid())
  pageId               String    @unique
  pageName             String
  // AES-256-GCM encrypted Page access token — see backend/src/lib/crypto.ts.
  encryptedAccessToken String
  leadFormCount        Int       @default(0)
  webhookSubscribed    Boolean   @default(false)
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("meta_ads_pages")
}

// A conversation with one external contact on WhatsApp or Instagram.
// WhatsApp always resolves to a Lead immediately (the channel gives us a phone number).
// Instagram has no phone number in its API, so leadId stays null until a CR team member
// manually converts it via the Social Inbox once they have the customer's phone number.
model Conversation {
  id                String        @id @default(cuid())
  channel           SocialChannel
  externalContactId String // phone number for WhatsApp, IGSID for Instagram
  contactName       String?
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id])
  isIgnored         Boolean       @default(false)
  convertedById     String?
  convertedBy       User?         @relation("ConvertedBy", fields: [convertedById], references: [id])
  convertedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  messages ChatMessage[]
  callLogs CallLog[]

  @@unique([channel, externalContactId])
  @@index([leadId])
  @@map("conversations")
}

model ChatMessage {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id])
  direction         MessageDirection
  body              String
  mediaUrl          String?
  externalMessageId String?
  createdAt         DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ---------- AI AGENTS / VOICE / MEDIA (Phase 3) ----------

// One row per bot type — the toggle a Branch Manager/Admin flips to turn a bot on/off,
// and the system prompt that drives it. OpenAI is only used to help draft this text
// (see modules/agent-configs); Gemini is what actually runs the agent at runtime.
model AgentConfig {
  id              String    @id @default(cuid())
  type            AgentType @unique
  name            String
  systemPrompt    String    @db.Text
  voiceName       String?
  model           String    @default("gemini-2.0-flash-live-001")
  isActive        Boolean   @default(false)
  // Global kill switch for the auto-dial pipeline (VOICE type only) — separate from
  // isActive, which gates the voice agent/manual campaigns generally.
  autoCallEnabled Boolean   @default(false)
  updatedById     String?
  updatedBy       User?     @relation("AgentConfigUpdatedBy", fields: [updatedById], references: [id])
  updatedAt       DateTime  @updatedAt

  @@map("agent_configs")
}

model MediaAsset {
  id                 String    @id @default(cuid())
  label              String
  mediaType          MediaType
  carModel           String?
  cloudinaryUrl      String
  cloudinaryPublicId String
  uploadedById       String
  uploadedBy         User      @relation("MediaUploadedBy", fields: [uploadedById], references: [id])
  createdAt          DateTime  @default(now())

  templates MessageTemplate[]

  @@map("media_assets")
}

model MessageTemplate {
  id                 String        @id @default(cuid())
  name               String
  channel            SocialChannel
  category           String
  bodyText           String        @db.Text
  mediaAssetId       String?
  mediaAsset         MediaAsset?   @relation(fields: [mediaAssetId], references: [id])
  metaTemplateName   String?
  metaApprovalStatus String?
  createdById        String
  createdBy          User          @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())

  campaigns MessageCampaign[]

  @@map("message_templates")
}

model CallLog {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  fromNumber      String
  toNumber        String
  status          CallStatus   @default(QUEUED)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  summary         String?      @db.Text
  transcript      String?      @db.Text
  insights        Json?
  externalCallId  String?      @unique
  createdAt       DateTime     @default(now())

  outboundTask OutboundCallTask?

  @@index([conversationId, createdAt])
  @@map("call_logs")
}

model OutboundCallCampaign {
  id                  String         @id @default(cuid())
  name                String
  agentConfigId       String
  branchId            String?
  // Callmatic has no API to create campaigns — each one is created by hand in their
  // dashboard. This is that campaign's ID, pasted in so calls route to the right place.
  // Null falls back to the single campaignId stored in Integration settings.
  callmaticCampaignId String?
  status              CampaignStatus @default(DRAFT)
  createdById         String
  createdBy           User           @relation("CallCampaignCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tasks OutboundCallTask[]

  @@map("outbound_call_campaigns")
}

model OutboundCallTask {
  id             String               @id @default(cuid())
  campaignId     String
  campaign       OutboundCallCampaign @relation(fields: [campaignId], references: [id])
  enquiryId      String
  enquiry        Enquiry              @relation(fields: [enquiryId], references: [id])
  phoneNumber    String
  // Callmatic's own call ID — set as soon as the call is triggered, used to poll
  // GET /calls/{callId} for completion data when their webhook can't be relied on.
  externalCallId String?              @unique
  status         CallStatus           @default(QUEUED)
  attemptCount   Int                  @default(0)
  lastAttemptAt  DateTime?
  callLogId      String?              @unique
  callLog        CallLog?             @relation(fields: [callLogId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([campaignId, status])
  @@map("outbound_call_tasks")
}

model MessageCampaign {
  id             String          @id @default(cuid())
  name           String
  templateId     String
  template       MessageTemplate @relation(fields: [templateId], references: [id])
  segmentFilters Json
  status         CampaignStatus  @default(DRAFT)
  createdById    String
  createdBy      User            @relation("MessageCampaignCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@map("message_campaigns")
}

model Comment {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enquiryId])
  @@index([userId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// Explicit user dismissal of a bell reminder (follow-up/birthday/anniversary). Reminders
// themselves are computed live, not stored — this table is the only thing that makes a
// dismissal persist, so a reminder only disappears when the user clears it, not on its own.
model ReminderDismissal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reminderId String
  dismissedAt DateTime @default(now())

  @@unique([userId, reminderId])
  @@index([userId])
  @@map("reminder_dismissals")
}

model SystemSettings {
  id               String   @id @default("singleton")
  quotationEnabled Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("system_settings")
}

// Local cache of India Post pincode/post-office lookups (backs the Add Lead wizard's
// City/Area/Pincode suggestions). Populated lazily the first time a pincode or name is
// looked up via the public postalpincode.in API, so repeat lookups (and the vast majority
// of common cities) get served from our own DB — no per-keystroke external calls, no CORS
// dependency on that 3rd-party API's availability.
model PostOffice {
  id        String   @id @default(cuid())
  pincode   String
  name      String
  city      String
  state     String
  createdAt DateTime @default(now())

  @@unique([pincode, name])
  @@index([pincode])
  @@index([name])
  @@index([city])
  @@map("post_offices")
}
