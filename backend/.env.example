DATABASE_URL="postgresql://user:password@host:5432/lotus_crm?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Encrypts Meta/WhatsApp/Instagram/Google Sheets credentials at rest (IntegrationConfig table).
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY="replace-with-a-32-byte-random-value"

# Phase 3 (not used yet) — declared here so keys are established as backend-only from day one.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Meta (Facebook) Lead Ads "Login with Facebook" OAuth — from your Meta Developer App.
# Optional: these can instead be set from the Integrations UI (Meta App Settings), which
# takes priority over these env vars when both are present.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Set once in the Meta App's Webhooks product settings alongside the callback URL; the exact
# string you choose, shared between this backend and the Meta dashboard.
# META_WEBHOOK_VERIFY_TOKEN=
# Publicly reachable base URL of this backend — must exactly match the OAuth redirect URI
# registered in the Meta App dashboard (…/api/integrations/meta/oauth/callback).
BACKEND_PUBLIC_URL="http://localhost:4000"

