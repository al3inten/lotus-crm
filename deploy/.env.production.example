# Copy to .env.production, fill in real values, NEVER commit the filled-in version.
# Used as the source of truth for env vars passed to `docker run` on each backend EC2 instance.

# --- Required ---
DATABASE_URL=postgresql://postgres:<db-password>@<db-instance-private-ip>:5432/lotus_crm?schema=public
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=8h
MASTER_ENCRYPTION_KEY=<32-byte value — must match whatever was used when any integration credentials were saved>
CORS_ORIGIN=https://<your-frontend-domain>
NODE_ENV=production
PORT=4000

# --- Optional (leave blank if unused) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
BACKEND_PUBLIC_URL=https://<your-api-domain>

# --- DB instance itself (not read by the app — for provisioning the Postgres container) ---
POSTGRES_DB=lotus_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<same value as in DATABASE_URL above>
